{
  "name": "scraper-life",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "check:controls": "node tools/controls-check.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "npm run build && wrangler deploy",
    "cf:preview": "npm run build && wrangler dev",
    "check:touch": "node tools/touch-pad-check.mjs",
    "check": "npm run check:controls && npm run check:touch && npm run check:character && npm run check:palette && npm run check:lighting && npm run check:music && npm run check:sfx && npm run check:voices && npm run check:crowd && npm run check:multiplayer && npm run check:features",
    "check:features": "node tools/scavenger-features-check.mjs",
    "check:character": "node tools/character-rig-check.mjs",
    "check:voices": "node tools/voice-check.mjs",
    "rig:character": "python3 tools/rig_and_animate.py build --fbx fbx/Survival_Character.fbx --no-morphs",
    "palette": "python3 tools/character_palette.py build",
    "check:palette": "node tools/palette-check.mjs",
    "sky": "python3 tools/bake_hdr_sky.py bake",
    "check:lighting": "node tools/lighting-check.mjs",
    "music": "python3 tools/bake_platform_music.py",
    "check:music": "node tools/music-check.mjs",
    "check:sfx": "node tools/sfx-check.mjs",
    "check:crowd": "node tools/crowd-check.mjs",
    "check:multiplayer": "node tools/multiplayer-check.mjs"
  },
  "dependencies": {
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "jsdom": "^30.1.2",
    "vite": "^7.1.7",
    "wrangler": "^4.149.0"
  }
}
